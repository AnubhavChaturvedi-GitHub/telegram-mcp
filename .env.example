# ==========================================================
#  JARVIS AI TELEGRAM  --  credentials
#  Copy to .env and fill in. NEVER commit .env.
# ==========================================================

# ---------- 1. TELEGRAM USER ACCOUNT (MTProto) ----------
# From https://my.telegram.org -> API development tools
# This is what gives Jarvis full context: every DM, group, channel.
TG_API_ID=
TG_API_HASH=
# Your phone in international format, e.g. +919876543210
TG_PHONE=

# ---------- 2. CONTROL BOT (BotFather) ----------
# From @BotFather -> /newbot. This is the approval panel that
# DMs you each drafted reply with Approve / Edit / Ignore.
TG_BOT_TOKEN=
# Your own numeric Telegram user id (from @userinfobot).
# Only this id may approve or send anything.
TG_OWNER_ID=

# ---------- 3. NVIDIA NIM (the brain) ----------
# From https://build.nvidia.com -> any model -> Get API Key
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Benchmarked live on this key, 2026-08-29, on a real Hinglish Telegram prompt:
#   nvidia/nemotron-3-super-120b-a12b   2.5s  best reply, right register   <-- default
#   openai/gpt-oss-120b                 1.9s  fast, slightly wordier
#   nvidia/nemotron-3.5-lightning-30b-a3b  22s  confused who was speaking
#   deepseek-ai/deepseek-v4-flash-0731   114s  far too slow for chat
# Listed in /models but NOT deployed (404): moonshotai/kimi-k2.6,
#   nvidia/llama-3.1-nemotron-70b-instruct. meta/llama-3.3-70b-instruct is 410 Gone.
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# --- Two models, each doing what it benchmarked best at ---
# AGENT_MODEL understands your commands and picks tools (gpt-oss won decisively:
#   it called send_message where both nemotrons called search_messages, 0.9s vs 2-28s).
# NVIDIA_MODEL above writes the actual replies in your voice (nemotron won on
#   Hinglish register and tone).
AGENT_MODEL=openai/gpt-oss-120b
AGENT_MAX_TOKENS=3000

NVIDIA_TEMPERATURE=0.6
NVIDIA_MAX_TOKENS=512

# ---------- 4. BEHAVIOUR ----------
# draft = every reply needs your approval (START HERE)
# auto  = replies fire instantly with no approval
DEFAULT_MODE=draft
# Reply to private DMs?
HANDLE_PRIVATE=true
# Reply in groups? (only when you are @mentioned or replied to)
HANDLE_GROUPS=true
# Never reply in these chat ids, comma separated
BLOCKLIST=
# Only reply in these chat ids (leave blank for all), comma separated
ALLOWLIST=
# Messages of history fed to the model as context
CONTEXT_MESSAGES=40
# Minimum seconds between two auto replies to the same chat
COOLDOWN_SECONDS=45
# Type for this many seconds before sending, so it looks human
TYPING_DELAY=2.5

# ---------- 5. WHO JARVIS IS PRETENDING TO BE ----------
OWNER_NAME=Anubhav
OWNER_ROLE=Trainer and content lead at TAP Academy
